<plist version="1.0">
<dict>
  <!-- Without this key macOS never shows the microphone prompt and getUserMedia fails silently (SDC 3.0.3's voice bug). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>SDC listens only while you press the microphone button, to turn your speech into text for your prompt.</string>
</dict>
</plist>
